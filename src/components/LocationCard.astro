---
interface Props {
  name: string;
  address: string;
  phone: string;
  email: string;
  hours: Record<string, string>;
  image?: string;
}

const { name, address, phone, email, hours, image } = Astro.props;
---

<div class="location-card">
  {image && (
    <div class="location-image">
      <img src={image} alt={name} />
    </div>
  )}
  <div class="location-content">
    <h3>{name}</h3>
    <div class="location-details">
      <p class="address">
        <strong>📍 Address:</strong> {address}
      </p>
      <p class="phone">
        <strong>📞 Phone:</strong> <a href={`tel:${phone}`}>{phone}</a>
      </p>
      <p class="email">
        <strong>✉️ Email:</strong> <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
    <div class="hours">
      <h4>Hours</h4>
      <ul>
        {Object.entries(hours).map(([day, time]) => (
          <li>
            <span class="day">{day}</span>
            <span class="time">{time}</span>
          </li>
        ))}
      </ul>
    </div>
    <a href="#contact" class="directions-btn">Get Directions</a>
  </div>
</div>

<style>
  .location-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .location-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .location-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: #e2e8f0;
  }

  .location-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-content {
    padding: 24px;
  }

  h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 16px;
    color: #1a202c;
  }

  .location-details {
    margin-bottom: 20px;
  }

  .address,
  .phone,
  .email {
    font-size: 14px;
    margin-bottom: 12px;
    color: #4a5568;
  }

  a {
    color: #667eea;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .hours h4 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #1a202c;
  }

  .hours ul {
    list-style: none;
    padding: 0;
    margin-bottom: 16px;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 6px 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .hours li:last-child {
    border-bottom: none;
  }

  .day {
    font-weight: 600;
    color: #2d3748;
  }

  .time {
    color: #718096;
  }

  .directions-btn {
    display: inline-block;
    background: #667eea;
    color: white;
    padding: 10px 20px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s ease;
  }

  .directions-btn:hover {
    background: #764ba2;
  }
</style>