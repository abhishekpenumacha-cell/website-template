---
import { getCollection } from 'astro:content';

const cases = (await getCollection('beforeAfter')).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<section class="before-after-gallery">
  <div class="container">
    <h2>Transformation Gallery</h2>
    <p class="subtitle">See the incredible results our patients have achieved</p>
    <div class="gallery-grid">
      {cases.map((caseItem, index) => (
        <div class="case-card">
          <div class="before-after-container" data-index={index}>
            <div class="before">
              <img src={caseItem.data.beforeImage} alt="Before" />
              <span class="label">Before</span>
            </div>
            <div class="after">
              <img src={caseItem.data.afterImage} alt="After" />
              <span class="label">After</span>
            </div>
            <div class="slider" style="--position: 50%"></div>
          </div>
          <div class="case-info">
            <h3>{caseItem.data.title}</h3>
            <p class="treatment-type">Treatment: {caseItem.data.treatment}</p>
            <p class="description">{caseItem.data.description}</p>
            <p class="duration">⏱️ Duration: {caseItem.data.duration}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .before-after-gallery {
    background: white;
    padding: 60px 20px;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h2 {
    font-size: 36px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 12px;
    color: #1a202c;
  }

  .subtitle {
    text-align: center;
    color: #718096;
    font-size: 18px;
    margin-bottom: 40px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
  }

  .case-card {
    background: #f7fafc;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .case-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1);
  }

  .before-after-container {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #e2e8f0;
    aspect-ratio: 1;
  }

  .before,
  .after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .before {
    z-index: 5;
  }

  .after {
    overflow: hidden;
  }

  .before img,
  .after img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slider {
    position: absolute;
    top: 0;
    left: var(--position, 50%);
    width: 4px;
    height: 100%;
    background: white;
    z-index: 10;
    cursor: ew-resize;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  }

  .label {
    position: absolute;
    top: 12px;
    padding: 4px 12px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    z-index: 15;
  }

  .before .label {
    left: 12px;
  }

  .after .label {
    right: 12px;
  }

  .case-info {
    padding: 20px;
  }

  .case-info h3 {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #1a202c;
  }

  .treatment-type {
    color: #667eea;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .description {
    color: #718096;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .duration {
    color: #a0aec0;
    font-size: 13px;
  }
</style>

<script>
  // Before/After slider functionality
  document.querySelectorAll('.before-after-container').forEach((container) => {
    let isActive = false;

    const handleMove = (e: MouseEvent | TouchEvent) => {
      if (!isActive) return;

      const rect = container.getBoundingClientRect();
      const x = e instanceof MouseEvent ? e.clientX : e.touches[0].clientX;
      const position = ((x - rect.left) / rect.width) * 100;

      if (position >= 0 && position <= 100) {
        const slider = container.querySelector('.slider') as HTMLElement;
        const before = container.querySelector('.before') as HTMLElement;
        slider.style.setProperty('--position', position + '%');
        before.style.width = position + '%';
      }
    };

    container.addEventListener('mousedown', () => (isActive = true));
    container.addEventListener('touchstart', () => (isActive = true));
    document.addEventListener('mouseup', () => (isActive = false));
    document.addEventListener('touchend', () => (isActive = false));
    document.addEventListener('mousemove', handleMove);
    document.addEventListener('touchmove', handleMove);
  });
</script>