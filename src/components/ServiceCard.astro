---
interface Props {
  title: string;
  description: string;
  icon: string;
  image: string;
  slug: string;
}

const { title, description, icon, image, slug } = Astro.props;
---

<div class="service-card">
  <div class="service-image">
    <img src={image} alt={title} />
  </div>
  <div class="service-content">
    <div class="service-icon">
      <i class={`icon-${icon}`}></i>
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    <a href={`/services/${slug}`} class="learn-more">Learn More →</a>
  </div>
</div>

<style>
  .service-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }

  .service-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-content {
    padding: 24px;
  }

  .service-icon {
    font-size: 32px;
    margin-bottom: 12px;
    color: #667eea;
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #1a202c;
  }

  p {
    color: #718096;
    margin-bottom: 16px;
    line-height: 1.6;
  }

  .learn-more {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .learn-more:hover {
    color: #764ba2;
  }
</style>