---
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
---

<div class="testimonial-carousel">
  <div class="carousel-container">
    <div class="testimonials-wrapper">
      {testimonials.map((testimonial, index) => (
        <div class="testimonial-card" key={index}>
          <div class="stars">
            {Array.from({ length: testimonial.data.rating }).map(() => (
              <span class="star">★</span>
            ))}
          </div>
          <p class="testimonial-text">"{}"</p>
          <p class="treatment">Treatment: {testimonial.data.treatment}</p>
          <div class="patient-info">
            {testimonial.data.image && (
              <img src={testimonial.data.image} alt={testimonial.data.patientName} class="patient-image" />
            )}
            <div>
              <p class="patient-name">{testimonial.data.patientName}</p>
              {testimonial.data.date && (
                <p class="patient-date">
                  {new Date(testimonial.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
                </p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .testimonial-carousel {
    width: 100%;
    overflow: hidden;
    background: #f7fafc;
    padding: 40px 20px;
  }

  .carousel-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .testimonials-wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .testimonial-card {
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .testimonial-card:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    transform: translateY(-4px);
  }

  .stars {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
  }

  .star {
    color: #ffd700;
    font-size: 20px;
  }

  .testimonial-text {
    color: #2d3748;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
  }

  .treatment {
    color: #718096;
    font-size: 14px;
    margin-bottom: 16px;
  }

  .patient-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .patient-image {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .patient-name {
    font-weight: 600;
    color: #1a202c;
    margin: 0;
  }

  .patient-date {
    font-size: 12px;
    color: #a0aec0;
    margin: 4px 0 0 0;
  }
</style>